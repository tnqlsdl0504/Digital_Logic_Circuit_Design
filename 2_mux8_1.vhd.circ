  <vhdl appearance="logisim_evolution" name="mux8_1">-- Library and package&#13;
library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
use ieee.std_logic_arith.all;&#13;
use ieee.std_logic_unsigned.all;&#13;
&#13;
-- entity&#13;
entity mux8_1 is&#13;
    port(&#13;
        d0, d1, d2, d3, d4, d5, d6, d7 : in std_logic;&#13;
        ch   : in std_logic_vector(2 downto 0);&#13;
        data : out std_logic&#13;
    );&#13;
end entity mux8_1;&#13;
&#13;
-- architecture&#13;
architecture bhv of mux8_1 is&#13;
begin&#13;
    process(d0, d1, d2, d3, d4, d5, d6, d7, ch)&#13;
    begin&#13;
        case ch is&#13;
            when "000" =&gt; data &lt;= d0;&#13;
            when "001" =&gt; data &lt;= d1;&#13;
            when "010" =&gt; data &lt;= d2;&#13;
            when "011" =&gt; data &lt;= d3;&#13;
            when "100" =&gt; data &lt;= d4;&#13;
            when "101" =&gt; data &lt;= d5;&#13;
            when "110" =&gt; data &lt;= d6;&#13;
            when "111" =&gt; data &lt;= d7;&#13;
            when others =&gt; data &lt;= '0';&#13;
        end case;&#13;
    end process;&#13;
end architecture bhv;&#13;
