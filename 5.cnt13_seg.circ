  <vhdl appearance="logisim_evolution" name="cnt13_seg">-- Library and package&#13;
library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
use ieee.std_logic_arith.all;&#13;
use ieee.std_logic_unsigned.all;&#13;
&#13;
-- entity&#13;
entity cnt13_seg is&#13;
    port(&#13;
        en      : in std_logic;&#13;
        vt      : in std_logic_vector(12 downto 0); -- 13-bit vector&#13;
        display : out std_logic_vector(7 downto 0)  -- "abcdefgdp"&#13;
    );&#13;
end entity cnt13_seg;&#13;
&#13;
-- architecture&#13;
architecture bhv of cnt13_seg is&#13;
begin&#13;
    process(en, vt)&#13;
        variable sum : integer range 0 to 15;&#13;
    begin&#13;
        -- 1. Count the number of '1's in vt&#13;
        sum := 0;&#13;
        for i in 0 to 12 loop&#13;
            if (vt(i) = '1') then&#13;
                sum := sum + 1;&#13;
            end if;&#13;
        end loop;&#13;
&#13;
        -- 2. Display on 7-segment with enable control&#13;
        if en = '0' then&#13;
            display &lt;= "00000000";&#13;
        else&#13;
            case sum is&#13;
                -- Digits 0 to 9&#13;
                when 0  =&gt; display &lt;= "11111100"; -- 0&#13;
                when 1  =&gt; display &lt;= "01100000"; -- 1&#13;
                when 2  =&gt; display &lt;= "11011010"; -- 2&#13;
                when 3  =&gt; display &lt;= "11110010"; -- 3&#13;
                when 4  =&gt; display &lt;= "01100110"; -- 4&#13;
                when 5  =&gt; display &lt;= "10110110"; -- 5&#13;
                when 7  =&gt; display &lt;= "11100000"; -- 7&#13;
                when 8  =&gt; display &lt;= "11111110"; -- 8&#13;
                when 9  =&gt; display &lt;= "11100110"; -- 9&#13;
                -- Letters A to F (10 to 15)&#13;
                when 10 =&gt; display &lt;= "11101110"; -- A&#13;
                when 11 =&gt; display &lt;= "00111110"; -- b&#13;
                when 12 =&gt; display &lt;= "10011100"; -- C&#13;
                when 13 =&gt; display &lt;= "01111010"; -- d&#13;
                when 14 =&gt; display &lt;= "10011110"; -- E&#13;
                when 15 =&gt; display &lt;= "10001110"; -- F&#13;
                when others =&gt; display &lt;= "00000000";&#13;
            end case;&#13;
        end if;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="seg_letters">-- Library and package&#13;
library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
use ieee.std_logic_arith.all;&#13;
use ieee.std_logic_unsigned.all;&#13;
&#13;
-- entity&#13;
entity seg_letters is&#13;
    port(&#13;
        en      : in std_logic;&#13;
        dat     : in std_logic_vector(2 downto 0);&#13;
        display : out std_logic_vector(7 downto 0)&#13;
    );&#13;
end entity seg_letters;&#13;
&#13;
-- architecture&#13;
architecture bhv of seg_letters is&#13;
begin&#13;
    process(en, dat)&#13;
    begin&#13;
        if en = '0' then&#13;
            display &lt;= "00000000";&#13;
        else&#13;
            case dat is&#13;
                when "000" =&gt; display &lt;= "11101110"; -- a (A)&#13;
                when "001" =&gt; display &lt;= "00111110"; -- b&#13;
                when "010" =&gt; display &lt;= "10011100"; -- c (C)&#13;
                when "011" =&gt; display &lt;= "01111010"; -- d&#13;
                when "100" =&gt; display &lt;= "10001110"; -- f (F)&#13;
                when "101" =&gt; display &lt;= "11110110"; -- g&#13;
                when others =&gt; display &lt;= "00000000";&#13;
            end case;&#13;
        end if;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
