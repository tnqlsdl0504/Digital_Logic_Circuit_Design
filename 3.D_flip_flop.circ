  <vhdl appearance="logisim_evolution" name="D_ff">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity D_ff is&#13;
    port(&#13;
        clk : in std_logic;&#13;
        D   : in std_logic;&#13;
        Q   : out std_logic&#13;
    );&#13;
end entity D_ff;&#13;
&#13;
architecture bhv of D_ff is&#13;
begin&#13;
    process(clk)&#13;
    begin&#13;
        if rising_edge(clk) then&#13;
            Q &lt;= D;&#13;
        end if;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="D_latch">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity D_latch is&#13;
    port(&#13;
        en : in std_logic;&#13;
        D  : in std_logic;&#13;
        Q  : out std_logic&#13;
    );&#13;
end entity D_latch;&#13;
&#13;
architecture bhv of D_latch is&#13;
begin&#13;
    process(en, D)&#13;
    begin&#13;
        if (en = '1') then&#13;
            Q &lt;= D;&#13;
        end if;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
